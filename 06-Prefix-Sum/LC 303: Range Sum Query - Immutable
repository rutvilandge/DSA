LC 303: Range Sum Query - Immutable
Pattern:Prefix Sum

Algorithm:
Build a prefix sum array.
Range sum = prefix[r] - prefix[l-1].
If l = 0, just use prefix[r].
Example :

nums = [1,2,3,4]

Prefix → [1,3,6,10]

Query [1,3]:

10 - 1 = 9 ✅

Answer =9
CODE:

class NumArray {
    vector<int> p;
public:
    NumArray(vector<int>& nums) {
        p.resize(nums.size());
        for (int i = 0; i < nums.size(); i++)
            p[i] = nums[i] + (i ? p[i-1] : 0);
    }

    int sumRange(int l, int r) {
        return p[r] - (l ? p[l-1] : 0);
    }
};
