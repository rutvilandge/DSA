LC 438 — Find All Anagrams in a String
Pattern:Sliding Window

 Algorithm
Make a window of size p.length().
Count characters in p and the window.
Move the window one step.
If counts match → store the starting index.

CODE:
class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        vector<int> ans;
        int a[26]={}, b[26]={};

        for(char c:p) a[c-'a']++;

        for(int i=0;i<s.size();i++) {
            b[s[i]-'a']++;

            if(i >= p.size())
                b[s[i-p.size()]-'a']--;

            if(i >= p.size()-1 && equal(a,a+26,b))
                ans.push_back(i-p.size()+1);
        }
        return ans;
    }
};
EX:
p = "ab"
s = "cbaebabacd"

"cb" ❌
"ba" ✅ → index 1
"ae" ❌
...
"ba" ❌
"ac" ❌
"ca" ❌

