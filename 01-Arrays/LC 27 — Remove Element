// LC 27 - Remove Element
// Pattern: Two Pointers
// Time: O(n)
// Space: O(1)

ALGO:
i = 0
for every j:
    if nums[j] != val:
        nums[i] = nums[j]
        i++
return i

CODE:
class Solution {
public:
    int removeElement(vector<int>& nums, int val) {
        int i = 0;

        for (int j = 0; j < nums.size(); j++) {
            if (nums[j] != val) {
                nums[i] = nums[j];
                i++;
            }
        }

        return i;
    }
};

