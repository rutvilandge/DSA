 // LC 136 - Single Number
// Pattern: XOR / Bit Manipulation
// Time: O(n)
// Space: O(1)

ALGO:
ans = 0
XOR every number with ans
Return ans
CODE:

class Solution {
public:
    int singleNumber(vector<int>& nums) {
        int ans = 0;

        for (int x : nums)
            ans ^= x;

        return ans;
    }
};

