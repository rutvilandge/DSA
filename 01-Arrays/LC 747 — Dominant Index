// LC 747 - Dominant Index
// Pattern: Array Traversal
// Time: O(n)
// Space: O(1)

ALGO:
Find largest
Find second largest
Check largest >= 2 × second largest

CODE:
class Solution {
public:
    int dominantIndex(vector<int>& nums) {
        int largest = -1, secondLargest = -1, index = -1;

        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] > largest) {
                secondLargest = largest;
                largest = nums[i];
                index = i;
            }
            else if (nums[i] > secondLargest) {
                secondLargest = nums[i];
            }
        }

        return (largest >= 2 * secondLargest) ? index : -1;
    }
};

EX:
[3, 6, 1, 0]

largest = 6
secondLargest = 3

6 >= 2 × 3
6 >= 6 ✅

Answer = index 1
