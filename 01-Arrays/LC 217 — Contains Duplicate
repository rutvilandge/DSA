// LC 217 - Contains Duplicate
// Pattern: Hash Set
// Time: O(n) average
// Space: O(n)

ALGO:
Create set
For each number:
    if already in set → true
    add to set
Return false




CODE:
class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        unordered_set<int> s;

        for (int x : nums) {
            if (s.count(x))
                return true;

            s.insert(x);
        }

        return false;
    }
};

EX:
[1, 2, 3, 1]

1 → add
2 → add
3 → add
1 → already exists → true ✅
